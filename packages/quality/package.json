{
  "name": "@audio/quality",
  "version": "1.2.0",
  "description": "Objective audio quality metrics — SNR, segmental SNR, log-spectral distance, spectral similarity, noise-reduction ratio, per-partial modulation depth, STOI and ESTOI speech intelligibility, the 2f-model's MUSHRA-like score",
  "type": "module",
  "sideEffects": false,
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepublishOnly": "node ../../../compile/tools/tested.js"
  },
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "dependencies": {
    "fourier-transform": "^2.2.0"
  },
  "keywords": [
    "audio",
    "dsp",
    "quality",
    "metrics",
    "snr",
    "log-spectral-distance",
    "lsd",
    "stoi",
    "estoi",
    "intelligibility",
    "2f-model",
    "mushra",
    "perceptual",
    "speech",
    "evaluation"
  ],
  "license": "MIT",
  "author": "Dmitry Iv. <dfcreative@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/audiojs/measure.git",
    "directory": "packages/quality"
  },
  "homepage": "https://github.com/audiojs/measure/tree/main/packages/quality",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "types": "index.d.ts",
  "funding": "https://github.com/sponsors/audiojs"
}
